# =============================================================================
# Flood Monitor — ตัวอย่างค่าตั้งระบบ (คัดลอกเป็น .env แล้วแก้ไข)
#   cp .env.example .env
# ค่าที่เว้นว่างไว้ = ไม่ใช้ / ใช้ค่าเริ่มต้น  ห้าม commit ไฟล์ .env ที่มีรหัสลับจริง
# =============================================================================

# -----------------------------------------------------------------------------
# โหมดข้อมูลและที่เก็บข้อมูล
# -----------------------------------------------------------------------------
# live = ดึงข้อมูลจริงจากหน่วยงาน, fixture = ข้อมูลจำลองสำหรับสาธิต (หน้าเว็บจะแสดงป้ายแจ้งว่าเป็นข้อมูลตัวอย่าง)
DATA_MODE=live
# sqlite = ไฟล์ฐานข้อมูลในเครื่อง (แนะนำสำหรับ Docker เครื่องเดียว), supabase = Postgres บนคลาวด์ (เช่น ใช้คู่กับ Vercel)
STORE=sqlite
# โฟลเดอร์เก็บไฟล์ SQLite (flood.db) ใน Docker คือ /app/data
DATA_DIR=./data
# ใช้เมื่อ STORE=supabase: URL โปรเจกต์ และ service role key (ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามใส่ในหน้าเว็บ)
# สร้างตารางด้วยไฟล์ supabase/migrations/20261003000000_init.sql (supabase db push หรือวางใน SQL Editor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# การดึงข้อมูล
# -----------------------------------------------------------------------------
# ดึงข้อมูลทุกกี่นาที (ค่าเริ่มต้น 10)
POLL_MINUTES=10
# ข้อมูลที่เก่ากว่ากี่นาทีถือว่า "ไม่มีข้อมูลล่าสุด" และจะไม่ใช้แจ้งเตือน (ค่าเริ่มต้น 60)
STALE_MINUTES=60
# เก็บข้อมูลย้อนหลังกี่ชั่วโมง ข้อมูลที่เก่ากว่านี้จะถูกลบอัตโนมัติ (ค่าเริ่มต้น 72)
HISTORY_HOURS=72
# เลือกแหล่งข้อมูล คั่นด้วยจุลภาค เว้นว่าง = ใช้ทั้งหมด
# bma-canal, bma-rain, bma-roadflood, bma-pump (ต้องใช้ IP ในประเทศไทย)
# thaiwater-canal, thaiwater-wl, thaiwater-rain, thaiwater-road (ใช้ได้จากคลาวด์), popnix
# ตัวอย่างสำหรับ Vercel (อยู่นอกประเทศไทย): SOURCES=thaiwater-canal,thaiwater-wl,thaiwater-rain,thaiwater-road
SOURCES=
# รหัสจังหวัดของ ThaiWater ที่ต้องการดึง (10 = กรุงเทพฯ, 11 = สมุทรปราการ, 12 = นนทบุรี, 13 = ปทุมธานี) หรือ all = ทั้งประเทศ
THAIWATER_PROVINCES=10,11,12,13
# เวลารอคำตอบจากแหล่งข้อมูลแต่ละครั้ง (มิลลิวินาที)
FETCH_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# การรันตัวดึงข้อมูลและการแจ้งเตือน
# -----------------------------------------------------------------------------
# 1 = รันตัวดึงข้อมูลภายในเซิร์ฟเวอร์เว็บ (Docker แบบ all-in-one ตั้งค่านี้ให้อัตโนมัติ)
EMBEDDED_WORKER=0
# 1 = เครื่องนี้เป็นผู้ส่งการแจ้งเตือน, 0 = ไม่ส่ง
# หากมีหลายเครื่องใช้ฐานข้อมูลเดียวกัน ให้เปิดเพียงเครื่องเดียว มิฉะนั้นผู้ใช้จะได้รับข้อความซ้ำ
RUN_ALERTS=1
# รหัสลับสำหรับเรียก /api/cron/poll (ส่งเป็น Authorization: Bearer <ค่านี้>)
# บน Vercel ให้ตั้งตัวแปรชื่อ CRON_SECRET แล้ว Vercel Cron จะส่งให้อัตโนมัติ
# หมายเหตุ: บัญชี Vercel Hobby ตั้ง cron ได้วันละครั้งเท่านั้น หาก deploy ไม่ผ่านให้แก้ schedule ใน vercel.json
# เป็นรายวัน หรือลบส่วน crons แล้วใช้บริการภายนอก (เช่น cron-job.org) เรียก URL นี้ทุก 10 นาทีแทน
# สร้างค่าสุ่มได้ด้วย: openssl rand -base64 32
CRON_SECRET=
# รหัสลับสำหรับ /api/ingest ใช้กับโหมด relay: เครื่องในประเทศไทยรัน
#   npm run worker -- --relay https://โดเมนของคุณ
# แล้วส่งข้อมูล กทม. ขึ้นมาที่เซิร์ฟเวอร์ (ตั้งค่าเดียวกันทั้งสองเครื่อง)
INGEST_TOKEN=

# -----------------------------------------------------------------------------
# หน้าเว็บ
# -----------------------------------------------------------------------------
# URL สาธารณะของเว็บ (ไม่ต้องมี / ท้าย) ใช้สร้างลิงก์ในข้อความแจ้งเตือนและอีเมลยืนยัน
PUBLIC_BASE_URL=
# ตำแหน่งเริ่มต้นเมื่อผู้ใช้ยังไม่ได้กำหนดบ้าน (เว้นไว้ = กรุงเทพมหานคร; โหมด fixture ใช้พื้นที่ตัวอย่าง)
# DEFAULT_LAT=13.7563
# DEFAULT_LNG=100.5018
# DEFAULT_LABEL=กรุงเทพมหานคร

# -----------------------------------------------------------------------------
# ช่องทางแจ้งเตือน (ช่องทางที่ไม่ได้ตั้งค่าจะถูกซ่อนในหน้าตั้งค่าแจ้งเตือน)
# -----------------------------------------------------------------------------
# Web Push (แจ้งเตือนบนเบราว์เซอร์/มือถือ) — สร้างคู่กุญแจด้วย: npm run vapid
# เปลี่ยนกุญแจแล้วผู้ใช้เดิมต้องกดเปิดการแจ้งเตือนใหม่
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# ช่องทางติดต่อผู้ดูแลระบบสำหรับผู้ให้บริการ push เช่น mailto:admin@example.org
VAPID_SUBJECT=

# LINE Messaging API (LINE Official Account) — จาก LINE Developers Console
# ตั้ง Webhook URL เป็น https://โดเมนของคุณ/api/line/webhook และเปิด "Use webhook"
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# ลิงก์เพิ่มเพื่อน เช่น https://lin.ee/xxxxxxx (แสดงให้ผู้ใช้กดในหน้าตั้งค่า)
LINE_ADD_FRIEND_URL=

# Telegram — สร้างบอทกับ @BotFather
TELEGRAM_BOT_TOKEN=
# ชื่อผู้ใช้ของบอท (ไม่ต้องมี @) ใช้สร้างลิงก์ t.me
TELEGRAM_BOT_USERNAME=
# รหัสลับของ webhook (A-Z a-z 0-9 _ -) แล้วลงทะเบียน webhook ครั้งเดียวด้วย:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://โดเมนของคุณ/api/telegram/webhook&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=

# ntfy (แอปแจ้งเตือนฟรี ไม่ต้องสมัคร) — เซิร์ฟเวอร์เริ่มต้น หรือเซิร์ฟเวอร์ของคุณเอง (https เท่านั้น)
NTFY_BASE_URL=https://ntfy.sh

# อีเมลผ่าน Resend (https://resend.com) — ต้องยืนยันโดเมนผู้ส่งก่อน
RESEND_API_KEY=
# ผู้ส่ง เช่น "Flood Monitor <alerts@your-domain.example>"
EMAIL_FROM=

# Discord ไม่ต้องตั้งค่าที่เซิร์ฟเวอร์ (ผู้ใช้วาง Webhook URL ของห้องเอง)

# -----------------------------------------------------------------------------
# ทางเลือก: Cloudflare Tunnel (ดู docker-compose.yml)
# -----------------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=
