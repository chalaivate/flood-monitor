{
  "name": "flood-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "ระบบเฝ้าระวังและแจ้งเตือนภัยน้ำท่วมตามตำแหน่งผู้ใช้ (Thailand flood early-warning)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postbuild": "node scripts/standalone-assets.mjs",
    "start:standalone": "node --env-file-if-exists=.env .next/standalone/server.js",
    "demo": "node scripts/demo.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx worker/poll.ts",
    "worker:once": "tsx worker/poll.ts --once",
    "vapid": "tsx worker/vapid.ts",
    "cctv:probe": "tsx worker/cctv-probe.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
